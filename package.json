{
  "name": "origin-reader",
  "version": "1.0.0",
  "description": "A quiet desktop PDF reader, a few words at a time.",
  "author": "Origin",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-electron.cjs",
    "start": "electron .",
    "test": "node --test tests/reader.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.cjs",
    "build:folder": "node scripts/build.cjs --folder"
  },
  "dependencies": { "pdfjs-dist": "6.5.438" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.origin.reader",
    "productName": "Origin Reader",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/**/*", "assets/icon.*", "package.json", "node_modules/pdfjs-dist/**/*", "!node_modules/@napi-rs/**/*", "!node_modules/pdfjs-dist/legacy/**/*", "!node_modules/pdfjs-dist/web/**/*", "!node_modules/pdfjs-dist/types/**/*", "!node_modules/pdfjs-dist/**/*.map"],
    "win": { "target": "portable", "icon": "assets/icon.ico", "signExecutable": false },
    "portable": { "artifactName": "Origin-Reader-${version}.exe" }
  }
}
